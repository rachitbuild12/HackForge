# =========================================================
# HACKFORGE // GITHUB OAUTH & INTEGRATION CONFIGURATION
# =========================================================

# Server Port
PORT=3001

# Frontend Origin URL (local: http://localhost:5173, production: https://hackforges.netlify.app)
CLIENT_URL=https://hackforges.netlify.app

# GitHub OAuth Application Credentials
# Create an OAuth App at: https://github.com/settings/developers
# - Application name: HackForge OS
# - Homepage URL: https://hackforges.netlify.app
# - Authorization callback URL: https://hackforges.netlify.app/api/auth/github/callback (or backend server callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret key for server-side session signing
SESSION_SECRET=hackforge_dev_secure_session_secret_key_9021

# =========================================================
# TINYFISH LIVE WEB RESEARCH CONFIGURATION
# Obtain your API key at: https://tinyfish.ai
# =========================================================
TINYFISH_API_KEY=

# =========================================================
# GITHUB APP INTEGRATION (RECOMMENDED // LEAST-PRIVILEGE)
# Create a GitHub App at: https://github.com/settings/apps/new
# Permissions:
#   - Repository metadata: Read-only
#   - Repository contents: Read-only
#   - Pull requests: Read-only
#   - Issues: Read-only
# Webhook events: push, pull_request, issues, installation
# Callback URL: http://localhost:3001/api/github/app/callback
# Webhook URL: http://localhost:3001/api/github/webhook
# =========================================================
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# =========================================================
# SUPABASE AUTHENTICATION & PERSISTENCE
# Apply schema: server/supabase_schema.sql in Supabase SQL Editor
# =========================================================
# Frontend Supabase Client
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Backend Server Supabase Client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
