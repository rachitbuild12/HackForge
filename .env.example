# =========================================================
# HACKFORGE // GITHUB OAUTH & INTEGRATION CONFIGURATION
# =========================================================

# Server Port
PORT=3001

# Frontend Origin URL (where Vite runs)
CLIENT_URL=http://localhost:5173

# GitHub OAuth Application Credentials
# Create an OAuth App at: https://github.com/settings/developers
# - Application name: HackForge OS
# - Homepage URL: http://localhost:5173
# - Authorization callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret key for server-side session signing
SESSION_SECRET=hackforge_dev_secure_session_secret_key_9021

# =========================================================
# TINYFISH LIVE WEB RESEARCH CONFIGURATION
# Obtain your API key at: https://tinyfish.ai
# =========================================================
TINYFISH_API_KEY=
